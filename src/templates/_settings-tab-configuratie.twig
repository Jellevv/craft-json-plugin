{% import '_includes/forms' as forms %}

<div id="tab-configuratie" class="{{ selectedTab != 'configuratie' ? 'hidden' : '' }}">
  <div class="field">
    <div class="heading">
      <label>Hier kan je alle secties en velden beheren die meegegeven moeten worden aan de chatbot</label>
    </div>
    <div class="warning">
      <p>Let op: Als je deze pagina saved, sync je ook alles automatisch met de chatbot.</p>
    </div>
  </div>

  <hr />

  <div class="field">
    <div class="heading">
      <label class="required">Sections</label>
      <div class="instructions"><p>Welke <strong>secties</strong> moeten worden meegegeven aan de chatbot?</p></div>
    </div>
    <div class="input">
      <div class="checkbox-wrapper checkbox-wrapper--select-all">
        <label>
          <input type="checkbox" id="select-all-sections">
          <strong>Alle secties</strong>
        </label>
      </div>
      {% for option in sectionOptions %}
        <div class="checkbox-wrapper">
          <label>
            <input
              type="checkbox"
              name="includedSections[]"
              value="{{ option.value }}"
              class="section-checkbox"
              data-section="{{ option.value }}"
              {{ option.value in settings.includedSections ? 'checked' : '' }}
            >
            {{ option.label }}
          </label>
        </div>
      {% endfor %}
    </div>
  </div>

  <hr />

  <div class="field">
    <div class="heading">
      <label>Fields</label>
      <div class="instructions"><p>Welke <strong>velden</strong> moeten worden meegegeven aan de chatbot?</p></div>
    </div>

    <div id="fields-by-section">

      {% for section in sectionOptions %}
        {% set sectionFields = sectionFieldMap[section.value] ?? [] %}
        <div class="section-fields-group" data-section="{{ section.value }}">

          <div class="section-fields-heading">
            <span>{{ section.label }}</span>
            {% if sectionFields is not empty %}
              <label class="select-all-fields-label">
                <input type="checkbox" class="select-all-fields" data-section="{{ section.value }}">
                Alles
              </label>
            {% endif %}
          </div>

          {% if sectionFields is empty %}
            <p class="section-fields-empty">Geen velden gevonden voor deze sectie.</p>
          {% else %}
            <div class="section-fields-grid">
              {% for fieldHandle in sectionFields %}
                {% set fieldLabel = fieldHandle %}
                {% for opt in fieldOptions %}
                  {% if opt.value == fieldHandle %}{% set fieldLabel = opt.label %}{% endif %}
                {% endfor %}

                <label class="field-checkbox-label">
                  <input
                    type="checkbox"
                    name="includedFields[]"
                    value="{{ fieldHandle }}"
                    class="field-checkbox"
                    data-section="{{ section.value }}"
                    {{ fieldHandle in settings.includedFields ? 'checked' : '' }}
                  >
                  {{ fieldLabel }}
                </label>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endfor %}

    </div>
  </div>

  <input type="hidden" id="settings-doSync" name="settings[doSync]" value="0">
</div>
